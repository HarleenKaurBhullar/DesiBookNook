---
import BaseLayout from './BaseLayout.astro';
import BookCard from '../components/BookCard.astro';
import CoverFan from '../components/CoverFan.astro';
import FormattedDate from '../components/FormattedDate.astro';
import type { Book } from '../lib/content';

interface Props {
  title: string;
  description: string;
  date: Date;
  books: Book[];
  ranked?: boolean;
}

const { title, description, date, books, ranked = false } = Astro.props;
const count = books.length;
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="wrap post-head">
      <div>
        <a class="back" href="/blog">Back to all lists</a>
        <h1>{title}</h1>
        <p class="dek">{description}</p>
        <p class="byline">
          <FormattedDate date={date} />
          <span class="pill">{count} {count === 1 ? 'book' : 'books'}</span>
        </p>
      </div>
      <CoverFan covers={books.map((b) => b.data.cover)} width={150} />
    </header>

    <div class="wrap">
      <div class="measure prose intro">
        <slot />
      </div>

      <section class="measure" aria-label="The books">
        {
          books.map((book, i) => (
            <BookCard id={book.id} {...book.data} rank={ranked ? i + 1 : undefined} />
          ))
        }
      </section>

      <p class="more">
        <a class="btn" href="/blog">See more lists</a>
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .post-head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2rem 3rem;
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 4vw, 2.5rem);
  }

  .back {
    display: inline-block;
    margin-bottom: 1.25rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
  }

  h1 {
    font-size: clamp(2.5rem, 6.5vw, 4.75rem);
    font-weight: 800;
    font-stretch: 85%;
    letter-spacing: -0.03em;
    line-height: 0.98;
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin: 1.25rem 0 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .dek {
    margin-top: 1.25rem;
  }

  .intro {
    padding-bottom: 1.5rem;
  }

  .more {
    padding-top: 2.5rem;
    margin: 0;
  }

  @media (max-width: 760px) {
    .post-head {
      grid-template-columns: 1fr;
    }
  }
</style>
