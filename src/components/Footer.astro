---
import { NAV_LINKS, SITE_TAGLINE, SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap inner">
    <div>
      <p class="brand">{SITE_TITLE}</p>
      <p class="tagline">{SITE_TAGLINE}</p>
    </div>
  </div>
  <p class="wrap legal">
    © {year}
    {SITE_TITLE}. Book covers belong to their publishers and artists.
  </p>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: clamp(3rem, 8vw, 6rem);
    padding-top: 3.5rem;
    padding-bottom: 2rem;
    background: var(--ink);
    color: var(--paper);
  }

  /* A row of colourful spine tops along the edge */
  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 12px;
    background: linear-gradient(
      90deg,
      var(--cobalt) 0 16.66%,
      var(--tangerine) 0 33.33%,
      var(--mint) 0 50%,
      var(--lemon) 0 66.66%,
      var(--pink) 0 83.33%,
      var(--paper) 0 100%
    );
  }

  .site-footer :focus-visible {
    outline-color: var(--lemon);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }

  .brand {
    margin: 0;
    color: var(--lemon);
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 85%;
    font-size: 2.2rem;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .tagline {
    margin: 0.5rem 0 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 600;
  }

  nav a:hover {
    color: var(--lemon);
  }

  .legal {
    margin-top: 2.5rem;
    margin-bottom: 0;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(236 232 250 / 0.25);
    font-size: 0.9rem;
    color: rgb(236 232 250 / 0.75);
  }
</style>
