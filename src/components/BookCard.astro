---
// One book. Two looks:
//   row  = cover beside the full write-up (used inside a post)
//   tile = cover with title and author underneath (used in grids)
interface Props {
  id: string;
  title: string;
  author: string;
  cover: string;
  blurb: string;
  link?:string;
  tags?: string[];
  rank?: number;
  variant?: 'row' | 'tile';
  showBlurb?: boolean;
  headingLevel?: 2 | 3;
}

const {
  id,
  title,
  author,
  cover,
  blurb,
  link,
  tags = [],
  rank,
  variant = 'row',
  showBlurb = false,
  headingLevel = variant === 'row' ? 2 : 3,
} = Astro.props;

const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article class:list={['book', variant]} id={id}>
  <div class="media">
    {
      rank && (
        <span class="rank" role="img" aria-label={`Number ${rank}`}>
          {rank}
        </span>
      )
    }
    <span class="cover">
    {link?(
    <a href={link} target="_blank" rel="sponsored noopener noreferrer" aria-label={`View ${title}`}>
      <img src={cover} alt={`Cover of ${title}`} width="300" height="450" loading="lazy" />
    </a>):
      <img src={cover} alt={`Cover of ${title}`} width="300" height="450" loading="lazy" />
    }
    </span>
  </div>

  <div class="body">
    <Heading>{
      link? (<a> class='title-link' href={link} target="_blank" rel="sponsored noopener noreferrer" aria-label={`View ${title}`}</a>)
      :(title)
      }
      </Heading>
    <p class="by">by {author}</p>
    {(variant === 'row' || showBlurb) && <p class="blurb">{blurb}</p>}
    <div class="meta">
      {
        link && (
          <a class="affiliate-btn" href={link} target="_blank" rel="sponsored noopener noreferrer">
            Get Book ↗
          </a>
        )
      }
      
      {
        variant === 'row' &&
          tags.map((tag) => (
            <a class="chip" href={`/books#${tag}`}>
              {tag}
            </a>
          ))
      }
    </div>
  </div>
</article>

<style>
  /* Arriving from a spine on the home page: ring the cover you landed on */
  .book:target .cover {
    outline: 4px solid var(--tangerine);
    outline-offset: 4px;
  }

  .media {
    position: relative;
  }

  .by {
    margin: 0.35rem 0 0;
    color: var(--ink-soft);
    font-family: var(--font-display);
    font-weight: 500;
  }

  .stars {
    font-size: 1.05rem;
    letter-spacing: 0.08em;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
  }
   
  /* Ensure the anchor tag doesn't disrupt image sizing */
  .cover a {
    display: contents; 
  }

  .title-link {
    color: inherit;
    text-decoration: none;
  }

  .title-link:hover {
    text-decoration: underline;
    text-decoration-color: var(--tangerine);
    text-underline-offset: 4px;
  }

  /* Affiliate Button Styles */
  .affiliate-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.75rem;
    background: var(--ink);
    color: var(--bg, #fff); /* Ensure this contrasts with --ink */
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
    transition: background-color 0.2s ease, translate 0.2s ease;
  }

  .affiliate-btn:hover {
    background: var(--tangerine);
    color: var(--ink);
    translate: 0 -2px;
  }

  /* ---------- Row ---------- */

  .row {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 1.5rem 2rem;
    padding-block: 2.25rem;
  }

  .row + .row {
    border-top: var(--line);
  }

  .row h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.1rem);
  }

  .row .blurb {
    margin: 0.9rem 0 1rem;
  }

  .rank {
    position: absolute;
    top: -14px;
    left: -14px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    background: var(--tangerine);
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1;
    border: 2px solid var(--ink);
    border-radius: 50%;
    box-shadow: 2px 2px 0 var(--ink);
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: 96px 1fr;
      gap: 1rem 1.25rem;
    }
    .rank {
      width: 38px;
      height: 38px;
      font-size: 1.25rem;
    }
  }

  /* ---------- Tile ---------- */

  .tile .cover {
    transition:
      translate 0.2s cubic-bezier(0.3, 1.5, 0.5, 1),
      rotate 0.2s cubic-bezier(0.3, 1.5, 0.5, 1);
  }

  .tile:hover .cover {
    translate: 0 -6px;
    rotate: -2deg;
  }

  .tile .body {
    padding-top: 1.1rem;
  }

  .tile h2,
  .tile h3 {
    font-size: 1.2rem;
    line-height: 1.1;
  }

  .tile .by {
    font-size: 0.95rem;
  }

  .tile .blurb {
    margin: 0.6rem 0 0;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .tile .meta {
    margin-top: 0.6rem;
  }
</style>
