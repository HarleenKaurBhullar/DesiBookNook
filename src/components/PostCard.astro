---
import CoverFan from './CoverFan.astro';
import FormattedDate from './FormattedDate.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  href: string;
  covers: string[];
  count: number;
}

const { title, description, date, href, covers, count } = Astro.props;
---

<a class="post-card" href={href}>
  <CoverFan covers={covers} width={104} />
  <div class="text">
    <h3>{title}</h3>
    <p class="desc">{description}</p>
    <p class="meta">
      <FormattedDate date={date} />
      <span class="pill">{count} {count === 1 ? 'book' : 'books'}</span>
    </p>
  </div>
</a>

<style>
  .post-card {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1.25rem 2.5rem;
    margin-inline: -1rem;
    padding: 1.75rem 1rem;
    color: var(--ink);
    text-decoration: none;
    border-top: var(--line);
    transition: background 0.15s ease;
  }

  .post-card:hover {
    background: var(--paper-deep);
    color: var(--ink);
  }

  h3 {
    font-size: clamp(1.6rem, 3.2vw, 2.3rem);
    text-decoration: underline transparent;
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.15em;
    transition: text-decoration-color 0.15s ease;
  }

  .post-card:hover h3 {
    text-decoration-color: var(--tangerine);
  }

  .desc {
    max-width: 46ch;
    margin: 0.6rem 0 0.9rem;
    color: var(--ink-soft);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
  }

  @media (max-width: 640px) {
    .post-card {
      grid-template-columns: 1fr;
    }
  }
</style>
