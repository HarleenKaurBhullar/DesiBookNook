---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCard from '../../components/BookCard.astro';
import { getAllBooks } from '../../lib/content';

const books = await getAllBooks();
const genres = [...new Set(books.flatMap((b) => b.data.tags))].sort();
---

<BaseLayout title="Books" description="Every book that has made a list on Dog-Eared, with a short note on each.">
  <section class="wrap page-head">
    <h1>Books</h1>
    <p class="dek">Every book that has made a list, best rated first. Filter by genre to narrow it down.</p>
  </section>

  <section class="wrap body">
    {
      books.length > 0 ? (
        <>
          <div class="filters" role="group" aria-label="Filter by genre">
            <button class="chip" type="button" data-filter="all" aria-pressed="true">
              All
            </button>
            {genres.map((genre) => (
              <button class="chip" type="button" data-filter={genre} aria-pressed="false">
                {genre}
              </button>
            ))}
          </div>

          <p id="filter-status" class="status" aria-live="polite">
            Showing {books.length} of {books.length} books
          </p>

          <ul class="grid">
            {books.map((book) => (
              <li data-book data-tags={book.data.tags.join(',')}>
                <BookCard id={book.id} {...book.data} variant="tile" showBlurb headingLevel={2} />
              </li>
            ))}
          </ul>
        </>
      ) : (
        <p>No books yet. Add a JSON file to src/content/books to put your first one on the shelf.</p>
      )
    }
  </section>
</BaseLayout>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-book]'));
  const status = document.getElementById('filter-status');

  function apply(tag: string) {
    let shown = 0;
    for (const item of items) {
      const tags = (item.dataset.tags ?? '').split(',');
      const match = tag === 'all' || tags.includes(tag);
      item.hidden = !match;
      if (match) shown++;
    }
    for (const button of buttons) {
      button.setAttribute('aria-pressed', String(button.dataset.filter === tag));
    }
    if (status) status.textContent = `Showing ${shown} of ${items.length} books`;
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const tag = button.dataset.filter ?? 'all';
      apply(tag);
      history.replaceState(null, '', tag === 'all' ? location.pathname : `#${tag}`);
    });
  }

  // Links like /books#fantasy open with that genre already selected.
  // Links like /books#piranesi are book ids, so the browser just scrolls to the book.
  const fromHash = decodeURIComponent(location.hash.slice(1));
  if (buttons.some((b) => b.dataset.filter === fromHash)) apply(fromHash);
</script>

<style>
  .body {
    padding-top: 1.5rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .status {
    margin: 1rem 0 2rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 2.5rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
