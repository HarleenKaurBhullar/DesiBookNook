---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookSpines from '../components/BookSpines.astro';
import PostCard from '../components/PostCard.astro';
import BookCard from '../components/BookCard.astro';
import { getAllBooks, getPostsWithBooks } from '../lib/content';
import { SITE_TAGLINE, SITE_TITLE } from '../consts';

const books = await getAllBooks();
const entries = await getPostsWithBooks();

const latest = entries.slice(0, 3);
const newest = entries[0];
const fiveStar = books.filter((b) => b.data.rating === 5).slice(0, 5);
const genres = [...new Set(books.flatMap((b) => b.data.tags))].sort();
const spines = books.map((b) => ({ id: b.id, title: b.data.title, author: b.data.author }));
---

<BaseLayout>
  <section class="wrap hero">
    <h1>{SITE_TITLE}</h1>
    <div class="lede-row">
      <p class="lede">{SITE_TAGLINE} Pick a spine to start.</p>
      <a class="btn" href="/blog">Browse all lists</a>
    </div>

    <div class="hero-shelf">
      {
        newest && (
          <a class="note" href={`/blog/${newest.post.id}`}>
            <span>Latest list</span>
            <strong>{newest.post.data.title}</strong>
            <span class="go">Read it</span>
          </a>
        )
      }
      <BookSpines books={spines} />
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>Latest lists</h2>
      <a class="text-link" href="/blog">See all lists</a>
    </div>

    {
      latest.length > 0 ? (
        <div class="post-list">
          {latest.map(({ post, books }) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              href={`/blog/${post.id}`}
              covers={books.map((b) => b.data.cover)}
              count={books.length}
            />
          ))}
        </div>
      ) : (
        <p>No lists yet. Add a Markdown file to src/content/posts to publish your first one.</p>
      )
    }
  </section>

  {
    fiveStar.length > 0 && (
      <section class="wrap section tight">
        <div class="section-head">
          <h2>Five-star reads</h2>
          <a class="text-link" href="/books">See every book</a>
        </div>
        <ul class="tiles">
          {fiveStar.map((book) => (
            <li>
              <a class="tile-link" href={`/books#${book.id}`}>
                <BookCard id={`pick-${book.id}`} {...book.data} variant="tile" />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    genres.length > 0 && (
      <section class="wrap section tight">
        <div class="section-head">
          <h2>Browse by genre</h2>
        </div>
        <ul class="genres">
          {genres.map((genre) => (
            <li>
              <a class="chip" href={`/books#${genre}`}>
                {genre}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    padding-top: clamp(2rem, 5vw, 3.5rem);
  }

  h1 {
    font-size: clamp(3.6rem, 16vw, 12rem);
    font-weight: 800;
    font-stretch: 78%;
    letter-spacing: -0.035em;
    line-height: 0.82;
  }

  .lede-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: 1.5rem;
  }

  .lede {
    max-width: 30ch;
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.4;
  }

  .hero-shelf {
    position: relative;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  /* The sticky note pointing at the newest list */
  .note {
    display: block;
    width: min(15rem, 100%);
    margin: 0 0 1rem;
    padding: 1.1rem 1.2rem 1.3rem;
    background: var(--lemon);
    color: var(--ink);
    font-family: var(--font-display);
    text-decoration: none;
    border: 2px solid var(--ink);
    box-shadow: 5px 5px 0 var(--ink);
    rotate: -2deg;
    transition: rotate 0.2s ease;
  }

  .note:hover {
    color: var(--ink);
    rotate: 0deg;
  }

  .note strong {
    display: block;
    margin: 0.35rem 0 0.7rem;
    font-weight: 750;
    font-size: 1.45rem;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .note .go {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 1000px) {
    .hero-shelf {
      padding-right: 17rem;
    }

    .note {
      position: absolute;
      top: 1.5rem;
      right: 0;
      margin: 0;
      rotate: 3deg;
    }
  }

  .tight {
    padding-top: 0;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 2rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tile-link {
    display: block;
    color: var(--ink);
    text-decoration: none;
  }

  .genres {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
